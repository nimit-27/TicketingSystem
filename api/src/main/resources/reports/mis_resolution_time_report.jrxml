<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="mis_resolution_time_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
<parameter name="fromDate" class="java.lang.String"/><parameter name="toDate" class="java.lang.String"/><parameter name="categoryId" class="java.lang.String"/><parameter name="subCategoryId" class="java.lang.String"/><parameter name="zoneCode" class="java.lang.String"/><parameter name="regionCode" class="java.lang.String"/><parameter name="districtCode" class="java.lang.String"/><parameter name="issueTypeId" class="java.lang.String"/><parameter name="divisionId" class="java.lang.String"/><parameter name="assignedTo" class="java.lang.String"/><parameter name="interval" class="java.lang.String"/>
<queryString><![CDATA[SELECT CASE UPPER(COALESCE($P{interval}, 'DAILY'))
 WHEN 'MONTHLY' THEN DATE_FORMAT(t.reported_date, '%Y-%m')
 WHEN 'QUARTERLY' THEN CONCAT(YEAR(t.reported_date), '-Q', QUARTER(t.reported_date))
 WHEN 'YEARLY' THEN DATE_FORMAT(t.reported_date, '%Y')
 WHEN 'WEEKLY' THEN CONCAT(YEARWEEK(t.reported_date, 3) DIV 100, '-W', LPAD(YEARWEEK(t.reported_date, 3) % 100, 2, '0'))
 ELSE DATE_FORMAT(t.reported_date, '%Y-%m-%d') END periodLabel, COUNT(*) resolvedTickets,
ROUND(AVG(TIMESTAMPDIFF(MINUTE,t.reported_date,t.resolved_at))/60,2) avgResolutionHours,
ROUND(MIN(TIMESTAMPDIFF(MINUTE,t.reported_date,t.resolved_at))/60,2) minResolutionHours,
ROUND(MAX(TIMESTAMPDIFF(MINUTE,t.reported_date,t.resolved_at))/60,2) maxResolutionHours
FROM tickets t WHERE t.reported_date >= STR_TO_DATE(COALESCE(NULLIF($P{fromDate}, ''), '2026-07-01'), '%Y-%m-%d')
  AND t.reported_date < DATE_ADD(STR_TO_DATE(COALESCE(NULLIF($P{toDate}, ''), DATE_FORMAT(CURRENT_DATE, '%Y-%m-%d')), '%Y-%m-%d'), INTERVAL 1 DAY)
  AND ($P{categoryId} IS NULL OR $P{categoryId} = '' OR t.category = $P{categoryId})
  AND ($P{subCategoryId} IS NULL OR $P{subCategoryId} = '' OR t.sub_category = $P{subCategoryId})
  AND ($P{zoneCode} IS NULL OR $P{zoneCode} = '' OR t.zone_code = $P{zoneCode})
  AND ($P{regionCode} IS NULL OR $P{regionCode} = '' OR t.region_code = $P{regionCode})
  AND ($P{districtCode} IS NULL OR $P{districtCode} = '' OR t.district_code = $P{districtCode})
  AND ($P{issueTypeId} IS NULL OR $P{issueTypeId} = '' OR t.issue_type_id = $P{issueTypeId})
  AND ($P{divisionId} IS NULL OR $P{divisionId} = '' OR t.division = $P{divisionId})
  AND ($P{assignedTo} IS NULL OR $P{assignedTo} = '' OR t.assigned_to = $P{assignedTo}) AND t.resolved_at IS NOT NULL AND t.status IN ('RESOLVED','CLOSED') GROUP BY periodLabel ORDER BY MIN(t.reported_date)]]></queryString>
<field name="periodLabel" class="java.lang.String"/><field name="resolvedTickets" class="java.lang.Long"/><field name="avgResolutionHours" class="java.math.BigDecimal"/><field name="minResolutionHours" class="java.math.BigDecimal"/><field name="maxResolutionHours" class="java.math.BigDecimal"/>
<title><band height="55"><staticText><reportElement x="0" y="0" width="802" height="28"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><text><![CDATA[Ticket Resolution Time Report]]></text></staticText><textField><reportElement x="0" y="30" width="802" height="20"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Tickets reported from " + ($P{fromDate} == null || $P{fromDate}.isEmpty() ? "2026-07-01" : $P{fromDate}) + " to " + ($P{toDate} == null || $P{toDate}.isEmpty() ? new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date()) : $P{toDate}) + " | " + $P{interval}]]></textFieldExpression></textField></band></title>
<columnHeader><band height="28"><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="0" y="0" width="130" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Period]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="130" y="0" width="192" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Total Resolved Tickets]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="322" y="0" width="160" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Avg Hours]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="482" y="0" width="160" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Min Hours]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="642" y="0" width="160" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Max Hours]]></text></staticText></band></columnHeader><detail><band height="24"><textField><reportElement x="0" y="0" width="130" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{periodLabel}]]></textFieldExpression></textField><textField><reportElement x="130" y="0" width="192" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{resolvedTickets}]]></textFieldExpression></textField><textField><reportElement x="322" y="0" width="160" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{avgResolutionHours}]]></textFieldExpression></textField><textField><reportElement x="482" y="0" width="160" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{minResolutionHours}]]></textFieldExpression></textField><textField><reportElement x="642" y="0" width="160" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{maxResolutionHours}]]></textFieldExpression></textField></band></detail>
</jasperReport>
