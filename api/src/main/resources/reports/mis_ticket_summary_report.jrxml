<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="mis_ticket_summary_report" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <style name="TableHeader" mode="Opaque" backcolor="#344767" forecolor="#FFFFFF">
        <box>
            <pen lineWidth="0.5" lineColor="#000000"/>
        </box>
    </style>
    <style name="TableCell">
        <box>
            <pen lineWidth="0.5" lineColor="#000000"/>
        </box>
    </style>

    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>
    <parameter name="categoryId" class="java.lang.String"/>
    <parameter name="subCategoryId" class="java.lang.String"/>
    <parameter name="zoneCode" class="java.lang.String"/>
    <parameter name="regionCode" class="java.lang.String"/>
    <parameter name="districtCode" class="java.lang.String"/>
    <parameter name="issueTypeId" class="java.lang.String"/>
    <parameter name="divisionId" class="java.lang.String"/>
    <parameter name="assignedTo" class="java.lang.String"/>
    <parameter name="interval" class="java.lang.String"/>

    <queryString><![CDATA[
SELECT CASE UPPER(COALESCE($P{interval}, 'DAILY'))
         WHEN 'MONTHLY' THEN DATE_FORMAT(t.reported_date, '%M %Y')
         WHEN 'QUARTERLY' THEN CONCAT(YEAR(t.reported_date), '-Q', QUARTER(t.reported_date))
         WHEN 'YEARLY' THEN DATE_FORMAT(t.reported_date, '%Y')
         WHEN 'WEEKLY' THEN CONCAT(YEARWEEK(t.reported_date, 3) DIV 100, '-W', LPAD(YEARWEEK(t.reported_date, 3) % 100, 2, '0'))
         ELSE DATE_FORMAT(t.reported_date, '%Y-%m-%d')
       END periodLabel,
       COUNT(*) totalTickets,
       SUM(t.status = 'OPEN') openTickets,
       SUM(t.status = 'ASSIGNED') assignedTickets,
       SUM(t.status = 'PENDING_WITH_REQUESTER') pendingWithRequestorTickets,
       SUM(t.status = 'PENDING_WITH_FCI') pendingWithFciTickets,
       SUM(t.status = 'PENDING_WITH_SERVICE_PROVIDER') pendingWithServiceProviderTickets,
       SUM(t.status = 'RESOLVED') resolvedTickets,
       SUM(t.status = 'CLOSED') closedTickets
FROM tickets t
WHERE t.reported_date >= STR_TO_DATE(COALESCE(NULLIF($P{fromDate}, ''), '2026-07-01'), '%Y-%m-%d')
  AND t.reported_date < DATE_ADD(STR_TO_DATE(COALESCE(NULLIF($P{toDate}, ''), DATE_FORMAT(CURRENT_DATE, '%Y-%m-%d')), '%Y-%m-%d'), INTERVAL 1 DAY)
  AND ($P{categoryId} IS NULL OR $P{categoryId} = '' OR t.category = $P{categoryId})
  AND ($P{subCategoryId} IS NULL OR $P{subCategoryId} = '' OR t.sub_category = $P{subCategoryId})
  AND ($P{zoneCode} IS NULL OR $P{zoneCode} = '' OR t.zone_code = $P{zoneCode})
  AND ($P{regionCode} IS NULL OR $P{regionCode} = '' OR t.region_code = $P{regionCode})
  AND ($P{districtCode} IS NULL OR $P{districtCode} = '' OR t.district_code = $P{districtCode})
  AND ($P{issueTypeId} IS NULL OR $P{issueTypeId} = '' OR t.issue_type_id = $P{issueTypeId})
  AND ($P{divisionId} IS NULL OR $P{divisionId} = '' OR t.division = $P{divisionId})
  AND ($P{assignedTo} IS NULL OR $P{assignedTo} = '' OR t.assigned_to = $P{assignedTo})
GROUP BY periodLabel
ORDER BY MIN(t.reported_date)
    ]]></queryString>

    <field name="periodLabel" class="java.lang.String"/>
    <field name="totalTickets" class="java.lang.Long"/>
    <field name="openTickets" class="java.math.BigDecimal"/>
    <field name="assignedTickets" class="java.math.BigDecimal"/>
    <field name="pendingWithRequestorTickets" class="java.math.BigDecimal"/>
    <field name="pendingWithFciTickets" class="java.math.BigDecimal"/>
    <field name="pendingWithServiceProviderTickets" class="java.math.BigDecimal"/>
    <field name="resolvedTickets" class="java.math.BigDecimal"/>
    <field name="closedTickets" class="java.math.BigDecimal"/>

    <title>
        <band height="55">
            <staticText>
                <reportElement x="0" y="0" width="802" height="28"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Ticket Summary Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="802" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Tickets reported from " + ($P{fromDate} == null || $P{fromDate}.isEmpty() ? "2026-07-01" : $P{fromDate}) + " to " + ($P{toDate} == null || $P{toDate}.isEmpty() ? new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date()) : $P{toDate}) + " | " + $P{interval}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="42">
            <staticText><reportElement style="TableHeader" x="0" y="0" width="92" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Period]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="92" y="0" width="65" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="157" y="0" width="65" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Open]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="222" y="0" width="75" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Assigned]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="297" y="0" width="100" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Pending with Requestor]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="397" y="0" width="85" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Pending with FCI]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="482" y="0" width="117" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Pending with Service Provider]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="599" y="0" width="100" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Resolved]]></text></staticText>
            <staticText><reportElement style="TableHeader" x="699" y="0" width="103" height="42"/><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Closed]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28">
            <textField><reportElement style="TableCell" x="0" y="0" width="92" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{periodLabel}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="92" y="0" width="65" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{totalTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="157" y="0" width="65" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{openTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="222" y="0" width="75" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{assignedTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="297" y="0" width="100" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{pendingWithRequestorTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="397" y="0" width="85" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{pendingWithFciTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="482" y="0" width="117" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{pendingWithServiceProviderTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="599" y="0" width="100" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{resolvedTickets}]]></textFieldExpression></textField>
            <textField><reportElement style="TableCell" x="699" y="0" width="103" height="28"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{closedTickets}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
