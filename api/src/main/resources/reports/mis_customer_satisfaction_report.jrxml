<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="mis_customer_satisfaction_report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
<parameter name="fromDate" class="java.lang.String"/><parameter name="toDate" class="java.lang.String"/><parameter name="categoryId" class="java.lang.String"/><parameter name="subCategoryId" class="java.lang.String"/><parameter name="zoneCode" class="java.lang.String"/><parameter name="regionCode" class="java.lang.String"/><parameter name="districtCode" class="java.lang.String"/><parameter name="issueTypeId" class="java.lang.String"/><parameter name="divisionId" class="java.lang.String"/><parameter name="assignedTo" class="java.lang.String"/><parameter name="interval" class="java.lang.String"/>
<queryString><![CDATA[SELECT CASE UPPER(COALESCE($P{interval}, 'DAILY'))
 WHEN 'MONTHLY' THEN DATE_FORMAT(t.reported_date, '%Y-%m')
 WHEN 'QUARTERLY' THEN CONCAT(YEAR(t.reported_date), '-Q', QUARTER(t.reported_date))
 WHEN 'YEARLY' THEN DATE_FORMAT(t.reported_date, '%Y')
 WHEN 'WEEKLY' THEN CONCAT(YEARWEEK(t.reported_date, 3) DIV 100, '-W', LPAD(YEARWEEK(t.reported_date, 3) % 100, 2, '0'))
 ELSE DATE_FORMAT(t.reported_date, '%Y-%m-%d') END periodLabel, COUNT(f.feedback_id) responses,
COALESCE(ROUND(AVG(f.overall_satisfaction),2),0) overallRating, COALESCE(ROUND(AVG(f.resolution_effectiveness),2),0) resolutionRating,
COALESCE(ROUND(AVG(f.communication_support),2),0) communicationRating, COALESCE(ROUND(AVG(f.timeliness),2),0) timelinessRating,
COALESCE(ROUND(AVG((f.overall_satisfaction+f.resolution_effectiveness+f.communication_support+f.timeliness)/4),2),0) compositeRating
FROM tickets t LEFT JOIN ticket_feedback f ON f.ticket_id=t.ticket_id WHERE t.reported_date >= STR_TO_DATE(COALESCE(NULLIF($P{fromDate}, ''), '2026-07-01'), '%Y-%m-%d')
  AND t.reported_date < DATE_ADD(STR_TO_DATE(COALESCE(NULLIF($P{toDate}, ''), DATE_FORMAT(CURRENT_DATE, '%Y-%m-%d')), '%Y-%m-%d'), INTERVAL 1 DAY)
  AND ($P{categoryId} IS NULL OR $P{categoryId} = '' OR t.category = $P{categoryId})
  AND ($P{subCategoryId} IS NULL OR $P{subCategoryId} = '' OR t.sub_category = $P{subCategoryId})
  AND ($P{zoneCode} IS NULL OR $P{zoneCode} = '' OR t.zone_code = $P{zoneCode})
  AND ($P{regionCode} IS NULL OR $P{regionCode} = '' OR t.region_code = $P{regionCode})
  AND ($P{districtCode} IS NULL OR $P{districtCode} = '' OR t.district_code = $P{districtCode})
  AND ($P{issueTypeId} IS NULL OR $P{issueTypeId} = '' OR t.issue_type_id = $P{issueTypeId})
  AND ($P{divisionId} IS NULL OR $P{divisionId} = '' OR t.division = $P{divisionId})
  AND ($P{assignedTo} IS NULL OR $P{assignedTo} = '' OR t.assigned_to = $P{assignedTo}) GROUP BY periodLabel ORDER BY MIN(t.reported_date)]]></queryString>
<field name="periodLabel" class="java.lang.String"/><field name="responses" class="java.lang.Long"/><field name="overallRating" class="java.math.BigDecimal"/><field name="resolutionRating" class="java.math.BigDecimal"/><field name="communicationRating" class="java.math.BigDecimal"/><field name="timelinessRating" class="java.math.BigDecimal"/><field name="compositeRating" class="java.math.BigDecimal"/>
<title><band height="55"><staticText><reportElement x="0" y="0" width="802" height="28"/><textElement textAlignment="Center"><font size="18" isBold="true"/></textElement><text><![CDATA[Customer Satisfaction Report]]></text></staticText><textField><reportElement x="0" y="30" width="802" height="20"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Tickets reported from " + ($P{fromDate} == null || $P{fromDate}.isEmpty() ? "2026-07-01" : $P{fromDate}) + " to " + ($P{toDate} == null || $P{toDate}.isEmpty() ? new java.text.SimpleDateFormat("yyyy-MM-dd").format(new java.util.Date()) : $P{toDate}) + " | " + $P{interval}]]></textFieldExpression></textField></band></title>
<columnHeader><band height="28"><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="0" y="0" width="110" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Period]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="110" y="0" width="120" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Responses]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="230" y="0" width="120" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Overall]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="350" y="0" width="110" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Resolution]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="460" y="0" width="110" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Communication]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="570" y="0" width="110" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Timeliness]]></text></staticText><staticText><reportElement mode="Opaque" backcolor="#344767" forecolor="#FFFFFF" x="680" y="0" width="110" height="28"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Composite]]></text></staticText></band></columnHeader><detail><band height="24"><textField><reportElement x="0" y="0" width="110" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{periodLabel}]]></textFieldExpression></textField><textField><reportElement x="110" y="0" width="120" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{responses}]]></textFieldExpression></textField><textField><reportElement x="230" y="0" width="120" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{overallRating}]]></textFieldExpression></textField><textField><reportElement x="350" y="0" width="110" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{resolutionRating}]]></textFieldExpression></textField><textField><reportElement x="460" y="0" width="110" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{communicationRating}]]></textFieldExpression></textField><textField><reportElement x="570" y="0" width="110" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{timelinessRating}]]></textFieldExpression></textField><textField><reportElement x="680" y="0" width="110" height="24"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{compositeRating}]]></textFieldExpression></textField></band></detail>
</jasperReport>